# =============================================================================
# Frontend (Vite) config. Copy to .env.local for local dev. NO SECRETS HERE.
# Anything named VITE_* is public: the browser can read it.
#
# The browser never needs a Supabase or Resend key. All mail goes through the
# Mail Worker (same-origin /api). Secrets live only in the Worker
# (`wrangler secret put` or the Cloudflare dashboard).
# =============================================================================

# Dev only: where the local Mail Worker listens (`npm run worker:dev`).
# Default if unset: http://127.0.0.1:8787
VITE_API_PROXY_TARGET=http://127.0.0.1:8787

# =============================================================================
# Frontend (Vite) config. Copy to .env.local for local dev. NO SECRETS HERE.
# Anything named VITE_* is public: the browser can read it.
#
# The browser never needs a Supabase or Resend key. All mail goes through the
# Mail Worker (same-origin /api). Secrets live only in the Worker
# (`wrangler secret put` or the Cloudflare dashboard).
# =============================================================================

# Dev only: where the local Mail Worker listens (`npm run worker:dev`).
# Default if unset: http://127.0.0.1:8787
VITE_API_PROXY_TARGET=http://127.0.0.1:8787

# -----------------------------------------------------------------------------
# NOT read from this file: the Worker's own config lives in worker/wrangler.toml
# [vars] and in the deployed Worker's dashboard settings (Settings -> Variables
# and Secrets, production). Both places must carry the same two Accounts URLs:
#
#   AUTH_HUB_URL    = https://api.gothwadtech.com
#                     Base for every SERVER-side Accounts call (/api/auth/me,
#                     /api/oauth/userinfo, /api/internal/usernames/:username).
#                     Must be a host that reaches the Accounts Worker (its
#                     Custom Domain). The Pages host accounts.gothwadtech.com
#                     answers HTML to a server-to-server call, which Mail
#                     reports as 503 accounts_unexpected_response.
#   AUTH_SIGNIN_URL = https://accounts.gothwadtech.com
#                     Browser-facing Accounts links only (sign-in redirect and
#                     accountUrl). Optional: falls back to AUTH_HUB_URL.
#
# Neither is a secret. For local worker dev they can also go in
# worker/.dev.vars (git-ignored); see docs/SETUP.md.
# -----------------------------------------------------------------------------

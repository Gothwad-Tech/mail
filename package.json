{
  "name": "gothwad-mail",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "test:worker": "node --import tsx --test worker/test/worker.test.ts",
    "test:config": "node --import tsx --test tests/worker-config.test.ts",
    "test:auth": "node --import tsx --test tests/auth-redirect.test.ts",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --port 8787",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:secrets:list": "wrangler secret list --config worker/wrangler.toml",
    "worker:secrets": "wrangler secret put ACCOUNTS_INTERNAL_TOKEN --config worker/wrangler.toml && wrangler secret put RESEND_API_KEY --config worker/wrangler.toml",
    "test:ui": "node --import tsx --test tests/ui-smoke.test.tsx",
    "test": "npm run test:config && npm run test:auth && npm run test:worker && npm run test:d1 && npm run test:ui",
    "test:d1": "node --import tsx --test tests/local-d1.test.ts",
    "preview:api": "node --import tsx tools/dev-server.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "postal-mime": "^2.7.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.149.0"
  }
}

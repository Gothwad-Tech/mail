# Copy to worker/.dev.vars for LOCAL `npm run worker:dev` only. Never commit .dev.vars.
# Placeholders only. Put real secrets in .dev.vars on your own machine, never in chat.
#
# Local D1: `wrangler dev` creates its own local SQLite copy of the `mail`
# database automatically. The Worker bootstraps the tables on the first request,
# so no SQL step is needed. Use `--remote` only when you mean the real database.
ENVIRONMENT=development
ACCOUNTS_INTERNAL_TOKEN=REPLACE_ME
RESEND_API_KEY=re_REPLACE_ME
# Local-only sign-in bypass (ignored when ENVIRONMENT=production):
DEV_AUTH_USERNAME=your_username
# Allow the Vite dev origin to call the API directly:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
